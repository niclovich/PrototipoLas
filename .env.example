APP_NAME="Sistema LAS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Con XAMPP: http://localhost/Tesis/Tesis/sistema-las/public  (o un virtual host http://sistema-las.test)
APP_URL=http://localhost/Tesis/Tesis/sistema-las/public

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_las
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@institutomilagro.edu.ar"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Usuario SUPERADMIN inicial (AdminSeeder). ADMIN_PASSWORD es obligatorio para sembrar.
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Sistema
ADMIN_DNI=00000000
ADMIN_EMAIL=admin@las.test
ADMIN_PASSWORD=

# Parámetros del instituto (config/las.php)
LAS_INSTITUTO_NOMBRE="Instituto Superior del Milagro"
LAS_PUNTO_VENTA=0001
LAS_CUOTA_DIA_VENCIMIENTO=10
LAS_LINK_ALTA_HORAS=48
LAS_LEGAJO_INICIAL=10000
